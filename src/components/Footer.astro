---
import { getCollection } from 'astro:content';
import { getNav } from '../lib/nav';
import { SITE, fmtDate } from '../lib/site';
const nav = await getNav();
const facts = await getCollection('facts');
const sources = await getCollection('sources');
const verified = facts.filter((f) => f.data.status === 'verified').length;
const latest = sources.length ? new Date(Math.max(...sources.map((s) => s.data.accessed.getTime()))) : undefined;
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <div class="footer-about">
      <p class="footer-pub">{SITE.publisher}</p>
      <p>{SITE.name}. An independent reference, not official documentation of RBI, NPCI or any bank. Nothing here is legal, compliance or investment advice.</p>
      <p class="footer-fresh">{verified} of {facts.length} facts verified against their sources{latest ? `, most recently on ${fmtDate(latest)}` : ''}. <a href="/sources/">How facts are checked</a></p>
    </div>
    <nav class="footer-dir" id="footer-nav" aria-label="All pages">
      {nav.map((g) => (
        <div data-domain={g.domain}>
          <h2>{g.title}</h2>
          <ul>{g.items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
