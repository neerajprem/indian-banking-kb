---
interface Props { headings: { depth: number; slug: string; text: string }[]; variant?: 'side' | 'inline' }
const { headings, variant = 'side' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 1 && (variant === 'side' ? (
  <nav class="toc" aria-labelledby="toc-title" data-toc>
    <p class="toc-title" id="toc-title">On this page</p>
    <ol>{items.map((h) => <li class={`lvl-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </nav>
) : (
  <details class="toc-inline">
    <summary>On this page</summary>
    <ol>{items.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </details>
))}
<script>
  import { ready } from '../scripts/ready';
  ready(() => {
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (!toc || toc.dataset.bound) return; toc.dataset.bound = '1';
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    const set = (id: string) => links.forEach((a) => a.setAttribute('aria-current', String(a.hash === '#' + id)));
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) set(visible[0].target.id);
    }, { rootMargin: '-80px 0px -65% 0px' });
    targets.forEach((t) => io.observe(t));
    if (targets[0]) set(targets[0].id);
  });
</script>
